    <div class="fixed bottom-4 right-4 z-50 flex flex-col items-end gap-3 sm:bottom-6 sm:right-6">
      <aside id="plan-panel" class="glass hidden w-[min(92vw,390px)] rounded-[2rem] border border-white/60 p-5" aria-label="Saved itinerary" aria-live="polite">
        <div class="flex items-start justify-between gap-4">
          <div>
            <div class="text-xs font-black uppercase tracking-[.14em] text-canopy-600">On this device</div>
            <h2 class="mt-1 font-display text-2xl">My TriNoma day</h2>
          </div>
          <button id="plan-close" type="button" class="flex h-9 w-9 items-center justify-center rounded-full bg-charcoal/5 font-bold" aria-label="Close itinerary">×</button>
        </div>
        <div id="plan-empty" class="mt-5 rounded-2xl bg-canopy-50 p-4 text-sm leading-6 text-charcoal/60">Nothing saved yet. Add a stop from the itinerary cards.</div>
        <ol id="plan-items" class="mt-4 space-y-2"></ol>
        <button id="plan-clear" type="button" class="mt-4 hidden text-xs font-extrabold text-charcoal/50 underline underline-offset-4">Clear saved list</button>
        <p class="mt-4 text-[11px] leading-4 text-charcoal/45">Stored only in localStorage in this browser. Nothing is uploaded.</p>
      </aside>
      <button id="plan-open" type="button" class="flex items-center gap-3 rounded-full bg-lime px-5 py-3.5 font-extrabold text-charcoal shadow-xl shadow-black/20 transition hover:-translate-y-0.5" aria-expanded="false" aria-controls="plan-panel">
        <span>My day</span><span id="plan-count" class="flex h-7 min-w-7 items-center justify-center rounded-full bg-charcoal px-2 text-xs text-white">0</span>
      </button>
    </div>

    <script>
      type PlanItem = { id: string; title: string; note: string };

      const STORAGE_KEY = 'trinoma-visitor-plan-v1';
      const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.plan-toggle'));
      const panel = document.querySelector<HTMLElement>('#plan-panel');
      const openButton = document.querySelector<HTMLButtonElement>('#plan-open');
      const closeButton = document.querySelector<HTMLButtonElement>('#plan-close');
      const clearButton = document.querySelector<HTMLButtonElement>('#plan-clear');
      const count = document.querySelector<HTMLElement>('#plan-count');
      const list = document.querySelector<HTMLOListElement>('#plan-items');
      const empty = document.querySelector<HTMLElement>('#plan-empty');

      const readPlan = (): PlanItem[] => {
        try {
          const saved = localStorage.getItem(STORAGE_KEY);
          if (!saved) return [];
          const parsed: unknown = JSON.parse(saved);
          if (!Array.isArray(parsed)) return [];
          return parsed.filter((item): item is PlanItem =>
            typeof item === 'object' && item !== null &&
            typeof (item as PlanItem).id === 'string' &&
            typeof (item as PlanItem).title === 'string' &&
            typeof (item as PlanItem).note === 'string'
          );
        } catch {
          return [];
        }
      };

      let plan: PlanItem[] = readPlan();

      const writePlan = () => {
        localStorage.setItem(STORAGE_KEY, JSON.stringify(plan));
      };

      const syncButtons = () => {
        const ids = new Set(plan.map((item) => item.id));
        buttons.forEach((button) => {
          const added = ids.has(button.dataset.planId ?? '');
          button.dataset.added = String(added);
          button.setAttribute('aria-pressed', String(added));
          const label = button.querySelector<HTMLElement>('.plan-label');
          if (label) label.textContent = added ? 'Saved to my day' : 'Add to my day';
          const icon = button.querySelector<HTMLElement>('span[aria-hidden="true"]');
          if (icon) icon.textContent = added ? '✓' : '＋';
        });
      };

      const render = () => {
        if (!count || !list || !empty || !clearButton) return;
        count.textContent = String(plan.length);
        list.replaceChildren();
        empty.classList.toggle('hidden', plan.length > 0);
        clearButton.classList.toggle('hidden', plan.length === 0);

        plan.forEach((item, index) => {
          const li = document.createElement('li');
          li.className = 'flex items-start gap-3 rounded-2xl bg-white p-3 shadow-sm';

          const number = document.createElement('span');
          number.className = 'mt-0.5 flex h-7 w-7 shrink-0 items-center justify-center rounded-full bg-canopy-100 text-xs font-black text-canopy-700';
          number.textContent = String(index + 1).padStart(2, '0');

          const text = document.createElement('div');
          text.className = 'min-w-0 flex-1';
          const title = document.createElement('div');
          title.className = 'font-extrabold text-sm';
          title.textContent = item.title;
          const note = document.createElement('div');
          note.className = 'mt-1 text-xs leading-5 text-charcoal/50';
          note.textContent = item.note;
          text.append(title, note);

          const remove = document.createElement('button');
          remove.type = 'button';
          remove.className = 'flex h-7 w-7 shrink-0 items-center justify-center rounded-full text-charcoal/40 hover:bg-charcoal/5';
          remove.setAttribute('aria-label', `Remove ${item.title}`);
          remove.textContent = '×';
          remove.addEventListener('click', () => {
            plan = plan.filter((saved) => saved.id !== item.id);
            writePlan();
            render();
          });

          li.append(number, text, remove);
          list.append(li);
        });

        syncButtons();
      };

      buttons.forEach((button) => {
        button.addEventListener('click', () => {
          const id = button.dataset.planId;
          const title = button.dataset.planTitle;
          const note = button.dataset.planNote;
          if (!id || !title || !note) return;

          const exists = plan.some((item) => item.id === id);
          plan = exists ? plan.filter((item) => item.id !== id) : [...plan, { id, title, note }];
          writePlan();
          render();
        });
      });

      openButton?.addEventListener('click', () => {
        const isHidden = panel?.classList.contains('hidden') ?? true;
        panel?.classList.toggle('hidden', !isHidden);
        openButton.setAttribute('aria-expanded', String(isHidden));
      });

      closeButton?.addEventListener('click', () => {
        panel?.classList.add('hidden');
        openButton?.setAttribute('aria-expanded', 'false');
        openButton?.focus();
      });

      clearButton?.addEventListener('click', () => {
        plan = [];
        writePlan();
        render();
      });

      render();
    </script>
  </body>
