---
import '../styles/global.css';

const siteUrl = Astro.site;
const pageTitle = 'TriNoma Mall Quezon City Visitor Guide';
const description = 'TriNoma Mall in Quezon City: MRT-3 North Avenue access, free entry, garden restaurants, parking, mall hours (Mon–Fri 11 AM–9 PM, Sat–Sun 10 AM–10 PM) and a store directory. Plan your visit.';
const canonicalUrl = siteUrl ? new URL(Astro.url.pathname, siteUrl).href : undefined;
const socialImageUrl = siteUrl ? new URL('/images/trinoma-exterior.webp', siteUrl).href : undefined;

const openingHours = [
  { day: 'Monday–Friday', hours: '11:00 AM–9:00 PM' },
  { day: 'Saturday–Sunday', hours: '10:00 AM–10:00 PM' },
];

const planStops = [
  {
    id: 'garden-restaurants',
    number: '01',
    title: 'Garden Restaurants',
    note: 'Start with the open-air landscaped side of TriNoma for a slower, greener first impression.',
    time: '45–75 min',
  },
  {
    id: 'mall-browse',
    number: '02',
    title: 'Mall + Landmark browse',
    note: 'Move through the main retail floors, cafés and department-store connection at your own pace.',
    time: '60–90 min',
  },
  {
    id: 'cinema-break',
    number: '03',
    title: 'Cinema or indoor break',
    note: 'Turn the visit into an easy half-day with a movie, coffee stop or indoor entertainment.',
    time: 'Optional',
  },
  {
    id: 'vertis-north',
    number: '04',
    title: 'Ayala Malls Vertis North',
    note: 'Pair TriNoma with the adjacent North Triangle district for a broader shopping and dining loop.',
    time: '60–120 min',
  },
  {
    id: 'sm-north-edsa',
    number: '05',
    title: 'SM City North EDSA',
    note: 'Add another major North EDSA mall if shopping variety is the goal of your day.',
    time: '60–120 min',
  },
  {
    id: 'wildlife-center',
    number: '06',
    title: 'Ninoy Aquino Parks & Wildlife Center',
    note: 'Switch from retail to trees and open space for a more balanced Quezon City day.',
    time: '60–90 min',
  },
];

const airportRoutes = [
  {
    mode: 'Fastest',
    title: 'Taxi / Grab direct',
    note: 'From NAIA T1, T2, T3 or T4, set your destination directly to TriNoma. In lighter traffic this is usually the simplest option; during peak periods, allow a wider time buffer.',
  },
  {
    mode: 'More predictable',
    title: 'Airport transfer + MRT-3',
    note: 'Take a taxi or ride-hailing car from the airport to MRT-3 Taft Avenue Station, then board a northbound train to North Avenue Station. From there, use the pedestrian connection toward TriNoma.',
  },
  {
    mode: 'Budget-first',
    title: 'Airport bus / PITX + North Avenue',
    note: 'If keeping costs lower matters most, take an airport bus or shuttle to PITX, then transfer to a northbound bus toward North Avenue and finish with a short walk or local ride to TriNoma. Stops and dispatch points may shift, so confirm on-site signage.',
  },
];

const faqs = [
  {
    q: 'Is there an entrance fee for TriNoma?',
    a: 'General mall entry is free. You pay only for what you choose to buy or use, such as food, shopping, cinema tickets, entertainment, parking, or separately ticketed events.',
  },
  {
    q: 'What are TriNoma’s mall hours?',
    a: 'Standard hours are Monday–Friday 11:00 AM–9:00 PM and Saturday–Sunday 10:00 AM–10:00 PM. Holiday and special-event schedules can differ, so check the live directory or on-site notices before a time-sensitive visit.',
  },
  {
    q: 'Which train station is best for TriNoma?',
    a: 'MRT-3 North Avenue Station is the most direct rail stop. A pedestrian connection links the station side with TriNoma, making rail the simplest option when EDSA road traffic is heavy.',
  },
  {
    q: 'What restaurants are at TriNoma?',
    a: 'TriNoma spans garden-side dining and indoor restaurants, from ramen and Italian to Filipino and café options. Tenant line-ups change, so use the live mall directory for the current restaurant list.',
  },
  {
    q: 'What stores are in TriNoma?',
    a: 'The mall mixes fashion, tech and mobile, home and lifestyle, and dining across its levels, anchored by The Landmark department store and supermarket. For the latest tenant list, check the official Ayala Malls TriNoma directory.',
  },
  {
    q: 'Is TriNoma the same as SM North EDSA?',
    a: 'No. TriNoma and SM City North EDSA are separate malls in the North EDSA district, a short distance apart. TriNoma connects directly to MRT-3 North Avenue Station.',
  },
  {
    q: 'When is the best time to visit?',
    a: 'For a calmer browse, arrive close to opening on a weekday. For the landscaped Garden Restaurants atmosphere, late afternoon into early evening is a pleasant choice.',
  },
  {
    q: 'How long should I stay?',
    a: 'Allow about two hours for a quick browse. Three to five hours works well for shopping plus a meal and garden time; add more time if you plan to watch a movie.',
  },
  {
    q: 'Can I park at TriNoma?',
    a: 'Yes. Ayala Malls lists the North and Mindanao carpark buildings. Posted operating hours and rates can change, so confirm the signage at the entrance before leaving your vehicle for an extended period.',
  },
  {
    q: 'Does the itinerary feature send my data anywhere?',
    a: 'No. Saved stops are stored only in your current browser using localStorage. This guide has no account system, database, or server-side itinerary storage.',
  },
];

const diningCategories = [
  { label: 'Japanese & ramen', note: 'Ramen counters and Japanese comfort food, such as Hanamaruken Ramen, Shou La Mien and Ramen Kuroda.' },
  { label: 'Italian & American', note: 'Sit-down favourites like Italianni’s and TGI Friday’s for a slower shared meal.' },
  { label: 'Filipino & quick bites', note: 'Casual Filipino plates and fast-food counters for a fast refuel between shopping blocks.' },
  { label: 'Cafés & dessert', note: 'Coffee stops and sweet breaks spread across the indoor levels and garden side.' },
];

const storeCategories = [
  { label: 'Fashion & lifestyle', title: 'Apparel & accessories', note: 'Everyday and boutique fashion across the retail floors, with accessories and footwear to match a full shopping loop.' },
  { label: 'Tech & mobile', title: 'Gadgets & devices', note: 'Phone, laptop and accessory specialists for upgrades and repairs, including mobile and electronics counters.' },
  { label: 'Home & grocery', title: 'The Landmark', note: 'The Landmark department store and supermarket anchor the mall with home, lifestyle and daily essentials.' },
  { label: 'Dining & events', title: 'Food & Activity Center', note: 'Restaurants, cafés and quick bites across the levels, with the Activity Center hosting mall events and programmes.' },
];

const attractionLd = {
  '@context': 'https://schema.org',
  '@type': ['ShoppingCenter', 'LocalBusiness', 'TouristAttraction'],
  name: 'TriNoma',
  alternateName: 'TriNoma Mall',
  description,
  hasMap: 'https://maps.app.goo.gl/b6AwEDVqWVTFLGhP9',
  sameAs: ['https://www.ayalamalls.com/main/malls/ayala-trinoma'],
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'EDSA corner North Avenue',
    addressLocality: 'Quezon City',
    addressRegion: 'Metro Manila',
    addressCountry: 'PH',
  },
  geo: {
    '@type': 'GeoCoordinates',
    latitude: 14.6517913,
    longitude: 121.0331526,
  },
  openingHoursSpecification: [
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
      opens: '11:00',
      closes: '21:00',
    },
    {
      '@type': 'OpeningHoursSpecification',
      dayOfWeek: ['Saturday', 'Sunday'],
      opens: '10:00',
      closes: '22:00',
    },
  ],
  aggregateRating: {
    '@type': 'AggregateRating',
    ratingValue: '3.9',
    reviewCount: '78',
    bestRating: '5',
  },
  isAccessibleForFree: true,
  priceRange: 'Free general entry; shopping, dining, parking and paid attractions vary',
  ...(siteUrl
    ? {
        url: new URL('/', siteUrl).href,
        image: [
          new URL('/images/trinoma-exterior.webp', siteUrl).href,
          new URL('/images/trinoma-garden.webp', siteUrl).href,
        ],
      }
    : {}),
};

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map(({ q, a }) => ({
    '@type': 'Question',
    name: q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: a,
    },
  })),
};
---

<!doctype html>
<html lang="en-PH">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#17211c" />
    <meta name="robots" content="index,follow,max-image-preview:large" />
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}

    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin />
    <link rel="preload" as="image" href="/images/trinoma-exterior.webp" fetchpriority="high" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="en_PH" />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    {socialImageUrl && <meta property="og:image" content={socialImageUrl} />}
    <meta name="twitter:card" content={socialImageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <link rel="manifest" href="/site.webmanifest" />

    <script type="application/ld+json" set:html={JSON.stringify(attractionLd)}></script>
    <script type="application/ld+json" set:html={JSON.stringify(faqLd)}></script>

    <!-- GA4: the only third-party script intentionally loaded by this guide. -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-HXM22WWPKP"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-HXM22WWPKP');
    </script>
  </head>
  <body class="overflow-x-hidden antialiased">
    <header class="absolute inset-x-0 top-0 z-30 py-5">
      <div class="shell flex items-center justify-between gap-5">
        <a href="#top" class="rounded-full bg-white/90 px-4 py-3 shadow-lg shadow-black/10 backdrop-blur" aria-label="TriNoma visitor guide home">
          <img src="/logo.svg" width="178" height="40" alt="TriNoma Visitor Guide" />
        </a>
        <nav class="hidden items-center gap-1 rounded-full bg-charcoal/85 p-1.5 text-sm font-semibold text-white backdrop-blur md:flex" aria-label="Primary navigation">
          <a class="rounded-full px-4 py-2 hover:bg-white/10" href="#visit">Plan</a>
          <a class="rounded-full px-4 py-2 hover:bg-white/10" href="#eat">Eat</a>
          <a class="rounded-full px-4 py-2 hover:bg-white/10" href="#hours">Hours</a>
          <a class="rounded-full px-4 py-2 hover:bg-white/10" href="#directory">Directory</a>
          <a class="rounded-full px-4 py-2 hover:bg-white/10" href="#arrive">Arrive</a>
          <a class="rounded-full px-4 py-2 hover:bg-white/10" href="#nearby">Nearby</a>
          <a class="rounded-full bg-lime px-4 py-2 text-charcoal hover:brightness-95" href="#map">Map</a>
        </nav>
      </div>
    </header>

    <main id="top">
      <section class="relative min-h-[830px] bg-charcoal text-white lg:min-h-[760px]">
        <img
          src="/images/trinoma-exterior.webp"
          alt="TriNoma exterior along North EDSA in Quezon City"
          width="1800"
          height="1355"
          fetchpriority="high"
          class="absolute inset-0 h-full w-full object-cover opacity-55"
        />
        <div class="absolute inset-0 bg-[linear-gradient(90deg,rgba(23,33,28,.92)_0%,rgba(23,33,28,.58)_48%,rgba(23,33,28,.18)_100%)]"></div>
        <div class="absolute inset-0 bg-[linear-gradient(0deg,rgba(23,33,28,.72),transparent_44%)]"></div>

        <div class="shell relative flex min-h-[830px] items-end pb-16 pt-40 lg:min-h-[760px] lg:items-center lg:pb-0">
          <div class="max-w-[800px]">
            <div class="mb-7 inline-flex items-center gap-3 rounded-full border border-white/20 bg-white/10 px-4 py-2 text-xs font-bold uppercase tracking-[.18em] backdrop-blur">
              <span class="h-2 w-2 rounded-full bg-lime"></span>
              North EDSA · Quezon City
            </div>
            <h1 class="font-display text-[clamp(3rem,9vw,7.6rem)] leading-[.9] tracking-[-.05em]">
              TriNoma Mall<br /><span class="italic text-lime">Quezon City</span>
            </h1>
            <p class="mt-8 max-w-2xl text-lg leading-8 text-white/78 md:text-xl">
              City energy on North EDSA, garden pause by the restaurants—a visitor-first guide to TriNoma, with MRT-3 access built into the rhythm of the day.
            </p>
            <div class="mt-9 flex flex-wrap gap-3">
              <a href="#visit" class="rounded-full bg-lime px-6 py-3.5 font-extrabold text-charcoal transition hover:-translate-y-0.5">Build your visit</a>
              <a href="#arrive" class="rounded-full border border-white/25 bg-white/10 px-6 py-3.5 font-bold text-white backdrop-blur hover:bg-white/15">How to get there</a>
            </div>
          </div>
        </div>

        <div class="shell relative -mb-16 grid translate-y-1/2 grid-cols-2 overflow-hidden rounded-[2rem] bg-white text-charcoal shadow-2xl shadow-black/25 md:grid-cols-4">
          <div class="border-b border-r border-charcoal/10 p-5 md:border-b-0 md:p-7">
            <div class="text-[.68rem] font-extrabold uppercase tracking-[.16em] text-canopy-600">Weekdays</div>
            <div class="mt-2 font-display text-2xl tracking-tight">11 AM–9 PM</div>
          </div>
          <div class="border-b border-charcoal/10 p-5 md:border-b-0 md:border-r md:p-7">
            <div class="text-[.68rem] font-extrabold uppercase tracking-[.16em] text-canopy-600">Weekends</div>
            <div class="mt-2 font-display text-2xl tracking-tight">10 AM–10 PM</div>
          </div>
          <div class="border-r border-charcoal/10 p-5 md:p-7">
            <div class="text-[.68rem] font-extrabold uppercase tracking-[.16em] text-canopy-600">Rail stop</div>
            <div class="mt-2 font-display text-2xl tracking-tight">MRT-3 North Ave.</div>
          </div>
          <div class="p-5 md:p-7">
            <div class="text-[.68rem] font-extrabold uppercase tracking-[.16em] text-canopy-600">General entry</div>
            <div class="mt-2 font-display text-2xl tracking-tight">Free</div>
          </div>
        </div>
      </section>

      <section class="pb-24 pt-36 md:pb-32 md:pt-44">
        <div class="shell grid items-center gap-12 lg:grid-cols-[.9fr_1.1fr] lg:gap-20">
          <div>
            <span class="eyebrow">The TriNoma mood</span>
            <h2 class="section-title">A mall that makes room for <span class="italic text-canopy-600">green.</span></h2>
            <p class="copy mt-7 max-w-xl text-lg">
              TriNoma sits in one of Metro Manila’s busiest transport-and-retail zones, yet its landscaped Garden Restaurants area gives the visit a softer counterpoint. Come for practical shopping; stay for the change of pace between indoor retail and open-air planting.
            </p>
            <div class="mt-8 flex flex-wrap gap-2 text-sm font-bold">
              <span class="rounded-full bg-canopy-100 px-4 py-2 text-canopy-800">Open-air gardens</span>
              <span class="rounded-full bg-white px-4 py-2 shadow-sm">Food + cinema</span>
              <span class="rounded-full bg-white px-4 py-2 shadow-sm">Direct rail access</span>
              <span class="rounded-full bg-white px-4 py-2 shadow-sm">North Triangle base</span>
            </div>
          </div>
          <div class="relative mx-auto w-full max-w-[680px]">
            <div class="dot-grid absolute -left-7 -top-7 h-52 w-52 rounded-[2rem]"></div>
            <img
              src="/images/trinoma-garden.webp"
              alt="Landscaped Garden Restaurants area at TriNoma"
              width="1800"
              height="1355"
              loading="lazy"
              class="photo-mask relative aspect-[4/3] w-full object-cover shadow-2xl shadow-canopy-900/15"
            />
            <div class="glass absolute -bottom-5 right-0 max-w-[260px] rounded-3xl p-5 md:right-5">
              <div class="text-xs font-black uppercase tracking-[.15em] text-canopy-600">Best contrast</div>
              <div class="mt-2 font-display text-xl leading-tight">Retail inside. Leafy pause outside.</div>
            </div>
          </div>
        </div>
      </section>

      <section id="visit" class="bg-canopy-900 py-24 text-white md:py-32">
        <div class="shell">
          <div class="flex flex-col justify-between gap-6 md:flex-row md:items-end">
            <div>
              <span class="eyebrow !text-lime">Your day, not ours</span>
              <h2 class="section-title max-w-3xl">Build a loose itinerary.</h2>
            </div>
            <p class="max-w-md text-sm leading-6 text-white/65">
              Tap any stop to save it. Your list stays in this browser only—no login, upload or server storage.
            </p>
          </div>

          <div class="mt-14 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
            {planStops.map((stop) => (
              <article class="group flex min-h-[280px] flex-col rounded-[2rem] border border-white/10 bg-white/[.06] p-7 transition hover:-translate-y-1 hover:bg-white/[.09]">
                <div class="flex items-start justify-between gap-4">
                  <span class="font-display text-5xl italic text-lime/70">{stop.number}</span>
                  <span class="rounded-full border border-white/15 px-3 py-1.5 text-xs font-bold text-white/60">{stop.time}</span>
                </div>
                <h3 class="mt-8 font-display text-3xl tracking-tight">{stop.title}</h3>
                <p class="mt-3 flex-1 text-sm leading-6 text-white/62">{stop.note}</p>
                <button
                  type="button"
                  class="plan-toggle mt-7 inline-flex w-fit items-center gap-2 rounded-full border border-white/25 px-4 py-2.5 text-sm font-extrabold transition hover:border-lime hover:text-lime"
                  data-plan-id={stop.id}
                  data-plan-title={stop.title}
                  data-plan-note={stop.note}
                  aria-pressed="false"
                >
                  <span aria-hidden="true">＋</span><span class="plan-label">Add to my day</span>
                </button>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section id="eat" class="py-24 md:py-32">
        <div class="shell grid gap-12 lg:grid-cols-[1.05fr_.95fr] lg:gap-18">
          <div class="overflow-hidden rounded-[2.5rem] bg-charcoal">
            <img
              src="/images/trinoma-interior.webp"
              alt="Interior retail levels inside TriNoma"
              width="1800"
              height="1355"
              loading="lazy"
              class="aspect-[4/3] h-full min-h-[480px] w-full object-cover opacity-90"
            />
          </div>
          <div class="py-2 lg:py-8">
            <span class="eyebrow">Around the table</span>
            <h2 class="section-title">Eat with a little <span class="italic text-canopy-600">air.</span></h2>
            <p class="copy mt-6 text-lg">
              The Garden Restaurants side is the natural place to anchor a meal, while the indoor floors cover quick bites, cafés and full-service dining. Restaurant line-ups do change, so use the mall directory for the live tenant list.
            </p>
            <div class="mt-9 space-y-3">
              <div class="rounded-3xl border border-charcoal/10 bg-white p-5">
                <div class="text-xs font-black uppercase tracking-[.14em] text-canopy-600">Ramen mood</div>
                <div class="mt-1 font-display text-2xl">Hanamaruken Ramen</div>
                <p class="copy mt-2 text-sm">A comfortable sit-down option when you want something warm and substantial.</p>
              </div>
              <div class="rounded-3xl border border-charcoal/10 bg-white p-5">
                <div class="text-xs font-black uppercase tracking-[.14em] text-canopy-600">Long lunch</div>
                <div class="mt-1 font-display text-2xl">Italianni’s</div>
                <p class="copy mt-2 text-sm">An easy pick for a slower shared meal between shopping blocks.</p>
              </div>
              <div class="rounded-3xl border border-charcoal/10 bg-white p-5">
                <div class="text-xs font-black uppercase tracking-[.14em] text-canopy-600">More choices</div>
                <div class="mt-1 font-display text-2xl">Shou La Mien · Ramen Kuroda · TGI Friday’s</div>
                <p class="copy mt-2 text-sm">Examples from the mall’s dining mix; check the live directory for relocations, closures and new openings.</p>
              </div>
            </div>
            <div class="mt-9 grid gap-3 sm:grid-cols-2">
              {diningCategories.map((cat) => (
                <div class="rounded-3xl border border-charcoal/10 bg-white p-5">
                  <div class="text-xs font-black uppercase tracking-[.14em] text-canopy-600">{cat.label}</div>
                  <p class="copy mt-2 text-sm">{cat.note}</p>
                </div>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section id="arrive" class="border-y border-charcoal/10 bg-white py-24 md:py-32">
        <div class="shell">
          <div class="grid gap-12 lg:grid-cols-[.85fr_1.15fr] lg:gap-18">
            <div>
              <span class="eyebrow">Getting there</span>
              <h2 class="section-title">Let North Avenue do the hard part.</h2>
              <p class="copy mt-6 text-lg">
                TriNoma is unusually practical for a Manila mall day because rail, road transport and the retail district meet in the same North Avenue–EDSA pocket.
              </p>
            </div>
            <div class="grid gap-4 sm:grid-cols-2">
              <article class="rounded-[2rem] bg-mist p-7">
                <div class="mb-8 flex h-12 w-12 items-center justify-center rounded-2xl bg-canopy-900 font-black text-lime">M</div>
                <h3 class="font-display text-2xl">MRT-3</h3>
                <p class="copy mt-3 text-sm">Get off at <strong>North Avenue Station</strong>. A pedestrian connection links the station side directly toward TriNoma, avoiding an EDSA street crossing.</p>
              </article>
              <article class="rounded-[2rem] bg-mist p-7">
                <div class="mb-8 flex h-12 w-12 items-center justify-center rounded-2xl bg-canopy-900 font-black text-lime">UV</div>
                <h3 class="font-display text-2xl">PUV / UV</h3>
                <p class="copy mt-3 text-sm">The transport terminal around North Avenue and Mindanao Avenue serves local public-utility routes. Route loading points can shift, so confirm signage on arrival.</p>
              </article>
              <article class="rounded-[2rem] bg-mist p-7">
                <div class="mb-8 flex h-12 w-12 items-center justify-center rounded-2xl bg-canopy-900 font-black text-lime">P2P</div>
                <h3 class="font-display text-2xl">Point-to-point bus</h3>
                <p class="copy mt-3 text-sm">A P2P terminal operates beside the mall area. Operators and schedules are time-sensitive; check the current departure board or operator channel before relying on a specific trip.</p>
              </article>
              <article class="rounded-[2rem] bg-mist p-7">
                <div class="mb-8 flex h-12 w-12 items-center justify-center rounded-2xl bg-canopy-900 font-black text-lime">CAR</div>
                <h3 class="font-display text-2xl">Taxi / ride-hailing</h3>
                <p class="copy mt-3 text-sm">Set the destination to TriNoma and use the indicated mall drop-off. During peak EDSA periods, allow buffer time for the final approach.</p>
              </article>
            </div>
          </div>

          <figure class="mt-14 overflow-hidden rounded-[2.5rem] bg-charcoal md:grid md:grid-cols-[1.2fr_.8fr]">
            <img
              src="/images/north-avenue-mrt.webp"
              alt="MRT-3 North Avenue Station viewed from TriNoma"
              width="1800"
              height="1355"
              loading="lazy"
              class="h-full min-h-[330px] w-full object-cover"
            />
            <figcaption class="flex flex-col justify-center p-8 text-white md:p-10">
